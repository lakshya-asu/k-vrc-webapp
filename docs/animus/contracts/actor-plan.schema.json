{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k-vrc.local/animus/actor-plan.schema.json",
  "title": "Animus Actor Plan 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary", "beats"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "beats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/beat" }
    }
  },
  "$defs": {
    "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at_ms", "duration_ms"],
      "anyOf": [
        { "required": ["body"] },
        { "required": ["gaze"] },
        { "required": ["face"] },
        { "required": ["speech"] }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 60 },
        "at_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "duration_ms": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "body": { "oneOf": [{ "$ref": "#/$defs/body" }, { "type": "null" }] },
        "gaze": { "oneOf": [{ "$ref": "#/$defs/gaze" }, { "type": "null" }] },
        "face": { "oneOf": [{ "$ref": "#/$defs/face" }, { "type": "null" }] },
        "speech": { "oneOf": [{ "$ref": "#/$defs/speech" }, { "type": "null" }] }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "enum": ["idle", "walk_to", "turn_to", "gesture", "interact", "wait"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 120 },
        "gesture": { "type": "string", "minLength": 1, "maxLength": 60 },
        "style": { "enum": ["neutral", "warm", "cold", "confident", "careful", "energetic", "tired"] },
        "intensity": { "$ref": "#/$defs/intensity" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "enum": ["walk_to", "turn_to", "interact"] } } },
          "then": { "required": ["target"] }
        },
        {
          "if": { "properties": { "action": { "const": "gesture" } } },
          "then": { "required": ["gesture"] }
        }
      ]
    },
    "gaze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": { "type": "string", "minLength": 1, "maxLength": 120 },
        "intensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression"],
      "properties": {
        "expression": { "type": "string", "minLength": 1, "maxLength": 80 },
        "intensity": { "$ref": "#/$defs/intensity" }
      }
    },
    "speech": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "delivery": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    }
  }
}
